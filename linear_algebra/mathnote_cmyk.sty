% ======================================================================
% ---- 論理記号 ----
% ----------------------------------------------------------------------
% 【記法の方針】
%   (1) 散文（地の文・定義文・命題の主張）では論理記号を用いず，日本語で
%       「かつ」「または」「〜ならば」「任意の〜に対して」「〜が存在して」
%       と書く．
%   (2) 論理式として数式に書き下すときは論理記号だけを用い，数式のなかに
%       日本語を混ぜない（\text{かつ} などを書かない）．
%   (3) ひとつの記号にひとつの意味だけを担わせる．とくに \to は写像と極限
%       に予約し，含意には \limp（⇒）を用いる．
%
%   矢印を長くしたい（⟹ ⟺ にしたい）場合は，下の \limp と \lequiv の
%   定義を \Longrightarrow / \Longleftrightarrow に変えるだけでよい．
% ======================================================================

% -- 結合子 --
% 論理積 \land，論理和 \lor，否定 \lnot は LaTeX 標準のものを用いる．
% 論理的同値（「つねに真」というメタ言語の主張）には \equiv を用いる．
\newcommand{\limp}  {\mathrel{\Rightarrow}}      % 含意「ならば」
\newcommand{\lequiv}{\mathrel{\Leftrightarrow}}  % 同値

% -- 量化子 --
% 使い方: \lall{x \in \mathbb{R}} \lst x^2 \geqq 0
%         \lall{a \in A} \lsep \lexu{b \in B} \lst (a, b) \in G
\newcommand{\lall}[1]{\forall\, #1}    % 全称量化子
\newcommand{\lex} [1]{\exists\, #1}    % 存在量化子
\newcommand{\lexu}[1]{\exists!\, #1}   % 一意存在量化子
\newcommand{\lst}     {\,:\,}          % 量化子と述語の区切り
\newcommand{\lsep}    {,\;}            % 量化子を並べるときの区切り

% -- 数式中で日本語の接続詞が必要になったとき --
% 上の方針 (2) により原則として使わない．図や表など，やむをえず数式に
% 日本語を入れる場合にだけ用いること．
\newcommand{\katsu} {\mathrel{\text{かつ}}}
\newcommand{\matawa}{\mathrel{\text{または}}}
\newcommand{\naraba}{\mathrel{\text{ならば}}}

% ---- 不等号を二重線に統一 ----
\renewcommand{\le} {\leqq}
\renewcommand{\ge} {\geqq}
\renewcommand{\leq}{\leqq}
\renewcommand{\geq}{\geqq}

% ---- 《題》スタイルの強調 ----
\newcommand\kakko[1]{\noindent\textbf{《#1》}}

% ---- underbrace のラベルが長いときに自動的に中央揃えにする ----
\newlength{\wdTempA}
\newlength{\wdTempB}
\newcommand{\adunderbrace}[2]{%
  \settowidth{\wdTempA}{$#1$}%
  \settowidth{\wdTempB}{${\scriptstyle #2}$}%
  \ifthenelse{\wdTempA<\wdTempB}{%
    \hspace*{.5\wdTempA}\hspace*{-.5\wdTempB}%
    \underbrace{#1}_{#2}%
    \hspace*{.5\wdTempA}\hspace*{-.5\wdTempB}%
  }{%
    \underbrace{#1}_{#2}%
  }%
}

%---- 証明のステップを強調表示するコマンド ----
\newcommand{\proofstep}[1]{%
  \par\smallskip
  \noindent
  \normalsize{■}%
  \hspace{0.5\zw}%
  \textbf{#1}\par\smallskip
}

% ---- 丸付き文字（\ctext{A} → 丸囲み A） ----
\newcommand{\ctext}[1]{\raise0.2ex\hbox{\textcircled{\scriptsize{#1}}}}

% ---- 横罫線（\HRule{太さ}） ----
\newcommand{\HRule}[1]{\rule{\linewidth}{#1}}

% \qty を siunitx の \SI に置換（amsmath との衝突回避）
\AtBeginDocument{\RenewCommandCopy\qty\SI}

% ---- \chikan: 置換の表記コマンド ----
% \chikan{x,y}{a,b}  → 置換表示（全要素）
% \chikan*{x,y}{a,b} → 不動点（上下一致）を自動的に除いた置換表示
\RequirePackage{expl3}
\ExplSyntaxOn
\NewDocumentCommand{\chikan}{s m m}{
  \group_begin:
  \clist_set:Nn \l_tmpa_clist {#2}
  \clist_set:Nn \l_tmpb_clist {#3}
  \IfBooleanTF{#1}
  {
    % スターあり: 上下一致（不動点）を除いてから出力
    \seq_clear:N \l_tmpa_seq
    \seq_clear:N \l_tmpb_seq
    \int_step_inline:nn { \clist_count:N \l_tmpa_clist } {
      \str_set:Nx \l_tmpa_str { \clist_item:Nn \l_tmpa_clist {##1} }
      \str_set:Nx \l_tmpb_str { \clist_item:Nn \l_tmpb_clist {##1} }
      \str_if_eq:NNF \l_tmpa_str \l_tmpb_str {
        \seq_put_right:NV \l_tmpa_seq \l_tmpa_str
        \seq_put_right:NV \l_tmpb_seq \l_tmpb_str
      }
    }
    % 全て不動点の場合は元のリストを安全に出力
    \int_compare:nNnTF { \seq_count:N \l_tmpa_seq } > { 0 }
      { \__chikan_render_seq:NN  \l_tmpa_seq  \l_tmpb_seq  }
      { \__chikan_render_clist:NN \l_tmpa_clist \l_tmpb_clist }
  }
  {
    % スターなし: そのまま出力
    \__chikan_render_clist:NN \l_tmpa_clist \l_tmpb_clist
  }
  \group_end:
}
\cs_new:Nn \__chikan_render_clist:NN {
  \left(
  \begin{array}{ *{ \clist_count:N #1 } {c} }
    \clist_use:Nn #1 { & } \\
    \clist_use:Nn #2 { & }
  \end{array}
  \right)
}
\cs_new:Nn \__chikan_render_seq:NN {
  \left(
  \begin{array}{ *{ \seq_count:N #1 } {c} }
    \seq_use:Nn #1 { & } \\
    \seq_use:Nn #2 { & }
  \end{array}
  \right)
}
\ExplSyntaxOff

% \input したサブファイルが独自の \documentclass を持っていても無視する
\RequirePackage{docmute}

% ==============================================================
% § 17. 証明環境のカスタマイズ
% ==============================================================

% QED マーク・証明名・\qed コマンドをまとめて設定
\renewcommand{\qedsymbol}{$\blacksquare$}
\renewcommand{\proofname}{\textbf{証明}}
\renewcommand{\qed}{\unskip\nobreak\quad\qedsymbol}

% proof 環境の本体を再定義
% \@addpunct のために \makeatletter が必要
\makeatletter
\renewenvironment{proof}[1][\proofname]{\par
  \pushQED{\qed}%
  \normalfont \topsep6\mnvpt\@plus6\mnvpt\relax
  \trivlist
  \item[\hskip\labelsep\normalfont#1\@addpunct{.}]%
  \mbox{}\par\nobreak\ignorespaces
}{%
  \popQED\endtrivlist\@endpefalse
}
\makeatother

% ==============================================================
% § 18. ドキュメント全体の設定
% ==============================================================

% secnumdepth はクラスファイルで設定済み（subsubsection まで）

% 全数式を displaystyle で組む（インライン数式も大きく表示）
\everymath{\displaystyle}

% 行送りを標準より 6% 広げる
\AtBeginDocument{%
  \linespread{1.06}\selectfont
  % 【追加】段落間にごく小さな伸び代（自然長は 0pt のまま）．
  % 段落数の多いページで \flushbottom が下端まで詰めやすくなる．
  % 見た目に影響が出ると感じたら削除してよい．
  \setlength{\parskip}{0pt plus 1\mnvpt}%
}
