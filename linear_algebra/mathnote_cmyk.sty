% ---- 絶対値・ノルムの自動サイズ調整デリミタ ----
% スター付き（\abs*{x}）で \left\right の自動サイズ調整
\DeclarePairedDelimiter{\abs} {\lvert}{\rvert}
\DeclarePairedDelimiter{\norm}{\lVert}{\rVert}

% ---- 分数のカスタマイズ ----
% \frac を displaystyle 優先の \bunsuu で上書きする
%   \bunsuu{分子}{分母}  ：常に \dfrac（displaystyle）ベース
%   \bunsuu*{分子}{分母} ：\mathchoice で数式スタイルに自動追従
%   \normalfrac{分子}{分母}：元の \frac を明示的に使いたい場合
\makeatletter

\let\oldfrac\frac

\DeclareRobustCommand{\bunsuu}{\@ifstar{\bunsuu@}{\@@bunsuu}}

% 通常版（常に \dfrac ベース）：分子・分母を微調整してバランスを改善
\def\@@bunsuu#1#2{%
  \dfrac{%
    \lower.16ex\hbox{$\m@th\displaystyle\mkern1mu#1\mkern1mu$}%
  }{%
    \lower-.036ex\hbox{$\m@th\displaystyle\mkern1mu#2\mkern1mu$}%
  }%
}

% textstyle 用（インライン数式内での分数）
\def\tbunsuu#1#2{%
  \tfrac{%
    \mkern1mu#1\mkern1mu
  }{%
    \lower-.05ex\hbox{$\m@th\scriptstyle\mkern1mu#2\mkern1mu$}%
  }%
}

% スター版：\mathchoice で display / text / script / scriptscript に自動追従
\def\bunsuu@#1#2{%
  \mathchoice
    {\@@bunsuu{#1}{#2}}%
    {\tbunsuu{#1}{#2}}%
    {\oldfrac{\mkern1mu#1\mkern1mu}{\mkern1mu#2\mkern1mu}}%
    {\oldfrac{\mkern1mu#1\mkern1mu}{\mkern1mu#2\mkern1mu}}%
}

\renewcommand{\frac}[2]{\bunsuu{#1}{#2}}
% 元の \frac を明示的に使う場合
\newcommand{\normalfrac}[2]{\oldfrac{#1}{#2}}

\makeatother

% ---- \sum・\prod を 0.97 倍に縮小 ----
% 本文サイズに対して記号が大きく見えすぎるのを補正する
\makeatletter

\let\orgsum\sum
\let\orgprod\prod

\DeclareRobustCommand{\sum}{%
  \mathop{\mathchoice
    {\vcenter{\hbox{\scalebox{0.97}{$\displaystyle\orgsum$}}}}%
    {\vcenter{\hbox{\scalebox{0.97}{$\textstyle\orgsum$}}}}%
    {\vcenter{\hbox{\scalebox{0.97}{$\scriptstyle\orgsum$}}}}%
    {\vcenter{\hbox{\scalebox{0.97}{$\scriptscriptstyle\orgsum$}}}}%
  }\limits%
}

\DeclareRobustCommand{\prod}{%
  \mathop{\mathchoice
    {\vcenter{\hbox{\scalebox{0.97}{$\displaystyle\orgprod$}}}}%
    {\vcenter{\hbox{\scalebox{0.97}{$\textstyle\orgprod$}}}}%
    {\vcenter{\hbox{\scalebox{0.97}{$\scriptstyle\orgprod$}}}}%
    {\vcenter{\hbox{\scalebox{0.97}{$\scriptscriptstyle\orgprod$}}}}%
  }\limits%
}

\makeatother

% ---- 数式周りの縦スペースを微調整 ----
% 【変更】(1) plus/minus（伸縮量）を追加：
%   固定長だと \flushbottom がページを下端まで詰められず，
%   ボックス移動時の下部余白がそのまま残ってしまうため．
% 【変更】(2) \AtBeginDocument で設定：
%   ltjsarticle ではサイズ命令（\normalsize 等）がこれらの長さを
%   再設定するため，プリアンブルでの \setlength は上書きされうる．
\AtBeginDocument{%
  % 本文（日本語）と別行立て数式の間を少し広げる．
  % 5pt -> 7pt，short 2pt -> 4pt とし，詰まり感を弱める．
  \setlength{\abovedisplayskip}{7\mnvpt plus 3\mnvpt minus 2\mnvpt}%
  \setlength{\belowdisplayskip}{7\mnvpt plus 3\mnvpt minus 2\mnvpt}%
  \setlength{\abovedisplayshortskip}{4\mnvpt plus 2\mnvpt minus 1\mnvpt}%
  \setlength{\belowdisplayshortskip}{4\mnvpt plus 2\mnvpt minus 1\mnvpt}%
  % 【追加 2026/08/11】クラスが再設定しない絶対長も A4 換算単位に揃える．
  % A4（11pt）ではいずれも既定値そのものになる（挙動不変）．
  % ・\jot / \multlinegap：amsmath の既定 3pt / 10pt（両クラスとも未調整だった）
  % ・\smallskip 系：カーネル既定 3/6/12pt（ltjsarticle は再設定しない）
  % ・\topsep：trivlist 系（center 等）が参照する大域値．
  %   ltjsarticle はクラス読込時の \@listi 実行で 0.5\baselineskip
  %   （linespread 適用前 = 0.5 x 16\jsc@mpt = A4 で 8.76pt）を残すので，
  %   その値を A4 換算で再現する．（list 環境内では \@listi が
  %   実行時の \baselineskip で再設定するため両版とも自動で相似．）
  % ※ \fboxsep・\fboxrule・\arraycolsep 等はクラスが \jsc@mpt 比例で
  %   設定済みなのでここでは触らない．
  \setlength{\jot}{3\mnvpt}%
  \setlength{\multlinegap}{10\mnpt}%
  % ・数式組版のカーネル既定絶対長：
  %   \scriptspace 0.5pt（添字の後アキ），\nulldelimiterspace 1.2pt
  %   （分数等の空デリミタ幅），\delimitershortfall 5pt（\left の
  %   可変括弧サイズ選択のしきい値．未換算だと B5 で A4 より小さい
  %   サイズの括弧が選ばれ，数式の幅・高さが相似から外れうる）
  \setlength{\scriptspace}{0.5\mnpt}%
  \setlength{\nulldelimiterspace}{1.2\mnpt}%
  \setlength{\delimitershortfall}{5\mnpt}%
  \setlength{\smallskipamount}{3\mnvpt plus 1\mnvpt minus 1\mnvpt}%
  \setlength{\medskipamount}{6\mnvpt plus 2\mnvpt minus 2\mnvpt}%
  \setlength{\bigskipamount}{12\mnvpt plus 4\mnvpt minus 4\mnvpt}%
  \setlength{\topsep}{8.76\mnpt}%
  % ・multicol の既定：\multicolsep=12pt±，\premulticols=50pt，
  %   \postmulticols=20pt（いずれも絶対値のため換算する）
  \setlength{\multicolsep}{12\mnvpt plus 4\mnvpt minus 3\mnvpt}%
  \setlength{\premulticols}{50\mnvpt}%
  \setlength{\postmulticols}{20\mnvpt}%
}

% 【追加】align / gather 等の複数行ディスプレイ数式の行間でも
% 改ページを許可する（amsmath）．長い証明の数式ブロックが
% 丸ごと次ページへ送られて大きな余白ができるのを防ぐ．
% 引数は 1（消極的）〜 4（積極的）．気に入らなければ [1] へ．
\allowdisplaybreaks[2]

