% mathnote_cmyk.sty
% LuaLaTeX / LuaHBTeX + mathnote_cmyk クラス用のスタイルファイル（B5・CMYK 版）
%
% 使い方（メインの .tex ファイル）:
%   \documentclass{mathnote_cmyk}   % 文書構造（余白・フォント等）
%   \usepackage{mathnote_cmyk}      % デザイン・マクロ・パッケージ追加
%
% mathnote.sty（A4・11pt 版）との差分は次の 2 点のみ：
%   (1) 出力カラーモデルを CMYK にする
%   (2) 絶対長（mm / pt）を「A4 換算単位」\mnmm / \mnpt / \mnvpt で書く
% 改ページ位置に影響する設定は A4 版と完全に同じにしてある．

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mathnote_cmyk}[2026/08/10 math note style: CMYK / B5 edition]

% CMYK版：xcolor が他パッケージから先に読み込まれる場合にも備えて，
% パッケージ読込前に出力カラーモデルを CMYK に指定する．
\PassOptionsToPackage{cmyk}{xcolor}

% ==============================================================
% § 0. 寸法のスケール単位（A4 版との体裁・改ページ位置合わせ）
% ==============================================================
%
% mathnote.sty（A4・11pt）と同じ体裁・同じ行取りを B5・9pt でも得るため，
% このファイル中の絶対長は mm / pt を直接書かず，次の「A4 換算単位」で書く．
%
%   \mnpt   A4 での 1pt。文字サイズに比例して縮む（A4 比 0.833790）
%   \mnmm   A4 での 1mm。同上
%           → 幅・箱の内部余白・飾りの座標・\fontsize に使う
%   \mnvpt  A4 での 1pt。行送りに比例して縮む
%           → 見出し前後・数式前後・箱の前後など「行取り」に効く縦アキに使う
%
% ltjsarticle は 9pt 指定のときだけ行送り係数 \n@baseline を 16 → 15 に
% 落とすため，素の状態では文字サイズの比（0.833790）と行送りの比
% （0.781678）が一致しない．mathnote_cmyk.cls は既定（similar モード）で
% \n@baseline を 16 に戻すため，通常は \mnvpt = \mnpt となり，縦横とも
% A4 版の 0.833790 倍の完全な相似形になる（改行・改ページ位置が一致）．
% \mnvpt の定義（＝\mnpt x \n@baseline/16）は，[nosimilar] オプションで
% 旧来の行送り比を選んだ場合にも縦アキが行グリッドに追随するよう残してある．
%
% A4（11pt）では 3 つとも本来の 1pt / 1mm に一致するので，この sty を
% そのまま A4 版に使っても mathnote.sty と同じ結果になる．
%
% 罫線の太さのうち，ボックスや見出しの「寸法」に算入されるもの
% （tcolorbox の boxrule / framed の \FrameRule / \titlerule /
%   見出し・目次 tikz の line width）は版面の消費量に効くため，
% A4 版との改行・改ページ一致のために \mnpt で縮める．
% 一方，寸法に算入されない純粋な上書き描画（borderline 系・
% \columnseprule・overlay 内の罫線）は，印刷で細りすぎないよう
% 絶対値のままにしてある．

% 保険：jsclasses 系以外で読まれた場合のフォールバック
\providecommand{\n@baseline}{16}
\ifdefined\zw\else \newdimen\zw \zw=10.95pt \fi

\newlength{\mnpt}
\newlength{\mnmm}
\newlength{\mnvpt}
% 【修正 2026/08/11】\mnpt の基準を \zw から \jsc@mpt に変更．
%   ltjsclasses の \zw は和文スケール 0.924715 を含む
%   （\zw = 0.924715 x 10 x \jsc@magscale pt = 10.1256pt/8.4426pt）ため，
%   旧定義 \zw*2000/21900 では \mnpt が意図値の 0.924715 倍となり，
%   ボックス内余白・見出し前後・数式前後の全寸法が約 7.5% 縮んで
%   A4 版と改行・改ページ位置がずれていた（横：箱内の字詰めが増える，
%   縦：ページに入る行数が増える）．
%   \jsc@mpt（= \jsc@magscale pt．11pt→1.095pt，9pt→0.913pt）を
%   10/10.95 = 200/219 倍すれば，A4 で厳密に 1pt，B5 で 0.913/1.095 pt
%   （= 0.8337899…pt）となり，文字サイズ比と厳密に一致する．
\ifdefined\jsc@mpt
  \setlength{\mnpt}{\dimexpr\jsc@mpt*200/219\relax}
\else
  % jsclasses 系以外で読まれた場合：欧文 \normalsize（\f@size pt）から換算
  \setlength{\mnpt}{\dimexpr\f@size\p@*20/219\relax}
\fi
\setlength{\mnmm} {\dimexpr\mnpt*7227/2540\relax}   % 1mm = 7227/2540 pt
\setlength{\mnvpt}{\dimexpr\mnpt*\n@baseline/16\relax}

