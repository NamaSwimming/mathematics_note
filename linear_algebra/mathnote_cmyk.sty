% ==============================================================
% § 5. Part 番号のローマ数字（文字詰め版）
% ==============================================================

% \tightromanpart{n}: 文字間を詰めた視覚的に均整のとれるローマ数字を出力
% グループ化は etoc が目次書き込み時に分断するのを防ぐため
\newcommand{\tightromanpart}[1]{%
  {%
  \ifcase#1%
  \or I%
  \or I\hspace{-1.2\mnpt}I%
  \or I\hspace{-1.2\mnpt}I\hspace{-1.2\mnpt}I%
  \or I\hspace{-1.2\mnpt}V%
  \or V%
  \or V\hspace{-1.2\mnpt}I%
  \or V\hspace{-1.2\mnpt}I\hspace{-1.2\mnpt}I%
  \or V\hspace{-1.2\mnpt}I\hspace{-1.2\mnpt}I\hspace{-1.2\mnpt}I%
  \or I\hspace{-1.2\mnpt}X%
  \or X%
  \else\uppercase\expandafter{\romannumeral#1}%
  \fi
  }%
}

% \tightpartnumber: 現在の part カウンタを \tightromanpart で出力
% .toc への書き込み時にも番号がずれないよう \DeclareRobustCommand で定義
%\DeclareRobustCommand{\tightpartnumber}{\tightromanpart{\value{part}}}
% \thepart の表示形式を詰めローマ数字に変更
\renewcommand{\thepart}{\tightromanpart{\value{part}}}

\DeclareRobustCommand{\tightpartnumber}{\tightromanpart{\value{part}}}

\renewcommand{\thepart}{\arabic{part}}
\renewcommand{\thesection}{\thepart.\arabic{section}}
\renewcommand{\thesubsection}{\thesection.\arabic{subsection}}

\makeatletter
\@addtoreset{section}{part}
\makeatother

% ==============================================================
% § 6. ページレイアウト（余白・ヘッダー・フッター・脚注）
% ==============================================================

% geometry / bxpapersize はクラスファイルで設定済み
% 図を絶対位置に配置する（textpos パッケージ）
\RequirePackage[absolute,overlay]{textpos}

% ---- 柱（ヘッダー）のフォーマット ----
% 偶数ページ左: ページ番号 + Part タイトル
% 奇数ページ右: Section タイトル + ページ番号
\RequirePackage{fancyhdr}
% \titleformat / \titlespacing（\section・\subsection の見出し整形で使用）
% 【変更】nobottomtitles* を追加：ページ下部の残り高さが
% \bottomtitlespace 未満なら，見出しを次ページ先頭へ送る．
% （見出しだけがページ最下部に孤立するのを防ぐ）
\RequirePackage[nobottomtitles*]{titlesec}
% 見出し＋本文数行が入らない場合に送る閾値（好みで調整．大きいほど早めに送る）
\renewcommand{\bottomtitlespace}{.15\textheight}

% 現在の Part・Section タイトルを保持するグローバル変数
\newcommand{\CurrentPartTitle}{}
\newcommand{\CurrentSectionTitle}{}

% ページスタイルの適用
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}  % ヘッダー下の罫線を消す

% 偶数ページ左柱：「p.〈番号〉　第〈n〉章　〈タイトル〉」
\fancyhead[LE]{%
  \footnotesize\strut
  p.\,\thepage\hspace{1.2\zw}\CurrentPartTitle
}
% 奇数ページ右柱：「〈節番号〉　〈タイトル〉 | p.〈番号〉」
\fancyhead[RO]{%
  \footnotesize\strut
  \CurrentSectionTitle\hspace{1\zw}|\hspace{1\zw}p.\,\thepage
}

% ---- 脚注のカスタマイズ ----
% 番号形式を「†1」「†2」... に変更
\renewcommand\thefootnote  {{\dag}\arabic{footnote}}
% ボックス（tcolorbox＝minipage 扱い）内の脚注は各ボックスで 1 から
% 振り直される（LaTeX の既定挙動）．本文の †1 と紛れないよう，
% 記号を「‡1」「‡2」... に変えて区別する．
\renewcommand{\thempfootnote}{{\ddag}\arabic{mpfootnote}}
% 脚注が改ページをまたぐのを極力避ける
\interfootnotelinepenalty=10000


% ---- Part：中央揃え + 二重グレー罫線 ----
\titleformat{\part}[display]
  {\normalfont\LARGE\bfseries\centering\color{appleInk}}
  {\large\color{appleGray}第\thepart 章}
  {-0.65ex}
  {}%
  [{%
    \vspace{0.6ex}%
    {\color{appleLineGray}\titlerule[1.2\mnpt]}%
    \nobreak\vspace{0.25ex}%
    {\color{appleLine}\titlerule[0.6\mnpt]}%
  }]

\titlespacing*{\part}
  {0pt}
  {-1.45\baselineskip}
  {1.4\baselineskip}

% \part / \section を拡張してタイトルを \gdef で更新する
% titlesec の \titleformat{\part}／\titlespacing*{\part} が \part 自体を
% 再定義するため，このラップは必ずそれらの後ろに置く
% （先に置くと titlesec の再定義で上書きされ，ここでの拡張が失われる）
\makeatletter

% --- \part の拡張 ---
\let\origpart\part
\renewcommand{\part}{%
  \@ifstar{\part@star}{\@ifnextchar[{\part@opt}{\part@noopt}}%
}

% \part は新しいページ（twoside では右ページ）から開始する
% ページ境界を明確にしないと \thispagestyle{empty} が
% 意図したページに適用されない（自然な改ページ位置に依存してしまう）ため
\def\part@newpage{%
  \pltx@cleartorightpage
  \thispagestyle{empty}%  % part ページは柱を出さない
}

% \part@autolabel{タイトル}
%   \part{タイトル} の直後に \label{part:タイトル} を自動的に張る．
%   これにより，本文中で \partref{タイトル} と書くだけで
%   「第 3 章」のような相互参照が得られる（§ 5.1 を参照）．
%   同じタイトルの章がふたつあると "multiply defined" 警告が出るので，
%   その場合は \part[短縮タイトル]{表示タイトル} で短縮側を一意にすること．
%   タイトルに数式やマクロを含む章では，直前に \partkey{...} を置いて
%   ラベル名を明示すること（下記）．
\global\let\part@key\@empty
\def\part@autolabel#1{%
  \ifx\part@key\@empty
    \label{\partrefprefix #1}%
  \else
    \label{\partrefprefix\part@key}%
    \global\let\part@key\@empty
  \fi
}

% オプション引数なし版
\def\part@noopt#1{%
  \part@newpage
  % .toc 書き込み時に \numberline を強制付与（etoc との互換性のため）
  \let\saved@addcontentsline\addcontentsline
  \def\addcontentsline##1##2##3{%
    \saved@addcontentsline{##1}{##2}{\protect\numberline{\thepart}#1}%
    \let\addcontentsline\saved@addcontentsline
  }%
  \origpart{#1}%
  \let\addcontentsline\saved@addcontentsline
  \part@autolabel{#1}%
  \gdef\CurrentPartTitle{第\thepart 章\quad #1}%
}

% オプション引数あり版 [短縮タイトル]{表示タイトル}
\def\part@opt[#1]#2{%
  \part@newpage
  \let\saved@addcontentsline\addcontentsline
  \def\addcontentsline##1##2##3{%
    \saved@addcontentsline{##1}{##2}{\protect\numberline{\thepart}#1}%
    \let\addcontentsline\saved@addcontentsline
  }%
  \origpart[#1]{#2}%
  \let\addcontentsline\saved@addcontentsline
  \part@autolabel{#1}%
  \gdef\CurrentPartTitle{第\thepart 章\quad #1}%
}

% スター版（番号なし）
\def\part@star#1{%
  \part@newpage
  \origpart*{#1}%
  \gdef\CurrentPartTitle{#1}%
}

\makeatother

% ==============================================================
% § 5.1 章・節の相互参照（\partref / \secref）
% ==============================================================
%
% 本書では \part を「第 n 章」として組んでいる（§ 7 の \titleformat）．
% 章番号を本文に直接書くと，章を追加・分割・入れ替えたときに
% すべて手で直すことになるため，ラベルによる参照を用意する．
%
%   \part{線型空間}          % ← \label{part:線型空間} が自動で張られる
%   ...
%   \partref{線型空間}       % → 「第 5 章」（リンク付き）
%   \partref*{線型空間}      % → 「第 5 章「線型空間」」
%
% 節を参照したい場合は，\section の直後に自分で \label を張る：
%   \section{行列の積}\label{sec:行列の積}
%   \secref{行列の積}        % → 「第 1.3 節」
%   \subsecref{ラベル}       % → 「第 1.3.2 項」（\label{subsec:...} が必要）
%
% ラベルの接頭辞を変えたい場合は \renewcommand{\partrefprefix}{...} とする
% （\part の自動ラベルもこの接頭辞を用いる）．

\newcommand{\partrefprefix}{part:}

% \partkey{ラベル名}
%   直後の \part のラベル名を明示的に指定する．
%   タイトルに数式やマクロが入る章で使う：
%     \partkey{RnとC}
%     \part{\texorpdfstring{$\mathbb{R}^n$と$\mathbb{C}$}{Rn と C}}
%     ...
%     \partref{RnとC}   % → 第 4 章
\makeatletter
\newcommand{\partkey}[1]{\gdef\part@key{#1}}
\makeatother

\makeatletter
\DeclareRobustCommand{\partref}{\@ifstar\partref@star\partref@plain}
% 「第 n 章」全体をひとつのリンクにする（\ref* は番号のみを返す）
\newcommand{\partref@plain}[1]{%
  \hyperref[\partrefprefix #1]{第\ref*{\partrefprefix #1}章}%
}
\newcommand{\partref@star}[1]{%
  \hyperref[\partrefprefix #1]{第\ref*{\partrefprefix #1}章「\nameref*{\partrefprefix #1}」}%
}
\makeatother

\newcommand{\secref}   [1]{\hyperref[sec:#1]{第\ref*{sec:#1}節}}
\newcommand{\subsecref}[1]{\hyperref[subsec:#1]{第\ref*{subsec:#1}項}}

% rule/caps color and bar fill/outline
\colorlet{secrule}{appleLineGray}
\colorlet{secbarfill}{appleGrayLight}
\colorlet{secbaredge}{appleGray}

\newlength{\secbarx}
\setlength{\secbarx}{8\mnmm}

\newlength{\sectextx}
\setlength{\sectextx}{12\mnmm}

% 番号付き section
\newcommand{\sectionheadrule}[2]{%
  \gdef\CurrentSectionTitle{\thesection\quad #2}%
  \noindent
  \begin{tikzpicture}[baseline=(title.base)]
    \path[use as bounding box]
      (0,-9\mnmm) rectangle (\linewidth,7\mnmm);

    % 中央の横罫線
    \draw[secrule,line width=0.4\mnpt]
      (0,0) -- (\linewidth,0);

    % 横罫線の左端の円
    \fill[secrule]
      (0,0) circle[radius=1\mnmm];

    % 横罫線の右端の円
    \fill[secrule]
      (\linewidth,0) circle[radius=1\mnmm];

    \fill[secbarfill]
      (\secbarx,-7.5\mnmm) rectangle ++(1.8\mnmm,13.5\mnmm);

    \draw[secbaredge,line width=0.4\mnpt]
      (\secbarx,-7.5\mnmm) rectangle ++(1.8\mnmm,13.5\mnmm);

    \draw[secbaredge,line width=0.4\mnpt]
      (\secbarx-0.9\mnmm,-7.5\mnmm) -- ++(0,13.5\mnmm);

    \node[
      anchor=south west,
      inner sep=0pt
    ] at (\sectextx,1.2\mnmm)
      {\color{SectionTag}\large\bfseries #1};

    \node[
      anchor=north west,
      inner sep=0pt
    ] (title) at (\sectextx,-1.6\mnmm)
      {\color{black}\Large\bfseries #2};
  \end{tikzpicture}%
}

% 番号なし section
\newcommand{\sectionheadrulestar}[1]{%
  \gdef\CurrentSectionTitle{#1}%
  \noindent
  \begin{tikzpicture}[baseline=(title.base)]
    \path[use as bounding box]
      (0,-9\mnmm) rectangle (\linewidth,7\mnmm);

    % 中央の横罫線
    \draw[secrule,line width=0.4\mnpt]
      (0,0) -- (\linewidth,0);

    % 横罫線の左端の円
    \fill[secrule]
      (0,0) circle[radius=1\mnmm];

    % 横罫線の右端の円
    \fill[secrule]
      (\linewidth,0) circle[radius=1\mnmm];

    \fill[secbarfill]
      (\secbarx,-7.5\mnmm) rectangle ++(1.8\mnmm,13.5\mnmm);

    \draw[secbaredge,line width=0.4\mnpt]
      (\secbarx,-7.5\mnmm) rectangle ++(1.8\mnmm,13.5\mnmm);

    \draw[secbaredge,line width=0.4\mnpt]
      (\secbarx-0.9\mnmm,-7.5\mnmm) -- ++(0,13.5\mnmm);

    \node[
      anchor=north west,
      inner sep=0pt
    ] (title) at (\sectextx,-1.6\mnmm)
      {\color{black}\Large\bfseries #1};
  \end{tikzpicture}%
}

\titleformat{\section}[block]
  {}{}{0pt}
  {\sectionheadrule{第\thesection 節}}

\titleformat{name=\section,numberless}[block]
  {}{}{0pt}
  {\sectionheadrulestar}

\titlespacing{\section}
  {0pt}{18\mnvpt}{14\mnvpt}

\setlength{\parindent}{1\zw}

\titleformat{\subsection}[block]
  {\normalfont\color{black}\large\bfseries}
  {\thesubsection}
  {0.7em}
  {}

% 星なし ＝ 見出し直後の段落を字下げする
\titlespacing{\subsection}{0pt}{14\mnvpt}{6\mnvpt}




% ==============================================================
% § 8. 目次（etoc — Apple 風デザイン）
% ==============================================================

\RequirePackage{etoc}

\makeatletter
\AtBeginDocument{%

  % 目次に表示する深さ（subsection まで）
  \etocsetnexttocdepth{subsection}

  % 目次ブロックの前後に TikZ でヘアラインを引き，中央に「目 次」を配置
\etocsettocstyle{%
  \par\vspace{10\mnvpt}%
  \noindent\hspace*{-\leftskip}%
  \begin{tikzpicture}[x=\linewidth, baseline]
    \draw[
      line cap=round,
      line width=0.8\mnpt,
      color=appleLine
    ] (0,0) -- (1,0);
    \node[
      inner sep=2.5\mnpt,
      outer sep=0pt,
      fill=appleCard
    ] at (0.5,0)
      {\bfseries\Large\textcolor{appleInk}{目\kern0.35em 次}};
  \end{tikzpicture}%
  \vspace{8\mnvpt}%

  % ここから目次項目を2段組にする
  \setlength{\columnsep}{24\mnpt}%
  \setlength{\columnseprule}{0pt}%
  \begin{multicols}{2}%
  \raggedcolumns
}{%
  % ここで目次項目の2段組を終了
  \end{multicols}%

  \vspace{4\mnvpt}%
  \noindent\hspace*{-\leftskip}%
  \begin{tikzpicture}[x=\linewidth, baseline]
    \draw[
      line cap=round,
      line width=0.5\mnpt,
      color=appleLine
    ] (0,0) -- (1,0);
  \end{tikzpicture}%
  \vspace{12\mnvpt}%
}

  % ---- Part エントリ（インデント=0，リーダー線あり） ----
  \etocsetstyle{part}
    {}
    {%
      \par\vskip11\mnvpt
      \parindent=0pt \leftskip=0pt
      \noindent
      \etoclink{%
        \bfseries\large\color{appleInk}%
        \makebox[1.5em][l]{\etocnumber}%
        \etocname
      }%
      \nobreak\leaders\hbox to .5em{\hss.\hss}\hfill \etocpage\par
      \vskip5.5\mnvpt
    }
    {}
    {}

  % ---- Section エントリ（インデント 30pt，リーダー線あり） ----
  \etocsetstyle{section}
    {\noindent}
    {%
      \vskip2.5\mnvpt
      \parindent=0pt
      \leftskip=24\mnpt
      \noindent
      \etoclink{%
        \bfseries\normalsize\color{appleInk}%
        \makebox[2.5em][l]{\etocnumber}%
        \etocname
      }%
      \nobreak\leaders\hbox to .5em{\hss.\hss}\hfill \etocpage\par
      \vskip3.5\mnvpt
    }
    {}
    {}

  % ---- Subsection エントリ（インデント 56pt，ページ番号はカッコ付き） ----
  \etocsetstyle{subsection}
  {\noindent}
  {%
    \parindent=0pt
    \leftskip=44\mnpt
    \rightskip=0pt
    \small
    \noindent
    \etoclink{%
      \makebox[3.4em][l]{\etocnumber}%
      \etocname
      \hspace{0.35em}%
      {(p.\etocpage)}%
    }%
    \par
  }
  {}
  {}

}%
\makeatother

% ==============================================================
% § 9. tcolorbox — 定理環境
% ==============================================================

\RequirePackage[many]{tcolorbox}
\tcbuselibrary{breakable,skins,theorems,xparse,hooks}
% ==============================================================
% § 9. 定理環境（Apple風・モノトーン）
% ==============================================================

% ---- 各環境のアクセント色（モノトーン） ----
\colorlet{acc@th}{appleInkGray}     % Theorem：濃い灰
\colorlet{acc@pr}{appleGrayDark}    % Proposition：やや濃い灰
\colorlet{acc@co}{appleGray}        % Corollary：中間灰
\colorlet{acc@ax}{appleInk}         % Axiom：ほぼ黒
\colorlet{acc@de}{appleGrayDark}    % Definition：濃い灰
\colorlet{acc@le}{appleGray}        % Lemma：中間灰
\colorlet{acc@ex}{appleGrayLight}   % Example：薄い灰
\colorlet{acc@qu}{appleLineGray}    % Question：淡い灰（白は使わない）

% ---- 追加：カードの薄い背景（Column 環境と同じ黒1%） ----
\colorlet{appleCardTint}{white}

% ---- 共通ベーススタイル ----
% 薄灰カード + 見出し下ヘアライン + 下端ヘアライン + 左に 2pt バー
\tcbset{
  theo-base/.style={
    enhanced, breakable, sharp corners,
    boxrule=0pt, no shadow,
    colback=appleCardTint,          % 【変更】白 → 薄灰カード
    colframe=appleCardTint,
    colbacktitle=appleCardTint,
    coltitle=appleInk,
    coltext=appleInk,
    fonttitle=\gtfamily\sffamily\bfseries\upshape,
    boxsep=1\mnmm,                     % 【追加】既定 1mm（絶対値）を換算
    left*=1\zw,
    right*=1\zw,
    toptitle=9\mnpt,                   % 【追加】見出し帯の上余白
    bottomtitle=7\mnpt,                % 【追加】見出し〜仕切り線の間
    top=9\mnpt,                        % 仕切り線〜本文の間
    bottom=10\mnpt,
    % 【変更】{0.8pt}{-2pt} → {0.5pt}{0pt}：
    %   背景に色が付くとカードの下端が見えるようになるため，
    %   2pt 外側に浮いた線は「ズレ」に見える．下端に密着させる．
    borderline south={0.5pt}{0pt}{appleLineGray},
    before skip=16\mnvpt plus 6\mnvpt minus 4\mnvpt,
    after skip=18\mnvpt plus 6\mnvpt minus 4\mnvpt,
    before upper={\setlength{\parindent}{1\zw}},
    before lower={\setlength{\parindent}{1\zw}},
    pad at break=0pt,
    enlarge top at break by=12\mnvpt,
    enlarge bottom at break by=0pt,
    % 【追加】見出しの下に全幅ヘアライン（Column 環境の区切り線と同族）．
    %   分割時は先頭パートにのみ描画される．
    overlay unbroken and first={
      \draw[appleLine, line width=0.4pt]
        (title.south west) -- (title.south east);
    },
  },
  mytheo/.style n args={1}{
    theo-base,
    borderline west={2pt}{0pt}{#1}
  },
}

% ---- 各定理環境（subsection 内で共通カウンタを使用） ----
\newtcbtheorem[number within=subsection]{theorem}   {Theorem}    {mytheo={acc@th}}{th}
\newtcbtheorem[use counter from=theorem]{prop}      {Proposition}{mytheo={acc@pr}}{pr}
\newtcbtheorem[use counter from=theorem]{cor}       {Corollary}  {mytheo={acc@co}}{co}
\newtcbtheorem[use counter from=theorem]{axiom}     {Axiom}      {mytheo={acc@ax}}{ax}
\newtcbtheorem[use counter from=theorem]{definition}{Definition} {mytheo={acc@de}}{de}
\newtcbtheorem[use counter from=theorem]{lemma}     {Lemma}      {mytheo={acc@le}}{le}
\newtcbtheorem[use counter from=theorem]{example}   {Example}    {mytheo={acc@ex}}{ex}
\newtcbtheorem[use counter from=theorem]{question}  {Question}   {mytheo={acc@qu}}{qu}

% ---- 参照コマンド（\thref{ラベル} → 太字サンセリフの "Theorem 1.2"） ----
\newcommand{\thref} [1]{\textsf{\bfseries Theorem~\ref{th:#1}}}
\newcommand{\prref} [1]{\textsf{\bfseries Proposition~\ref{pr:#1}}}
\newcommand{\coref} [1]{\textsf{\bfseries Corollary~\ref{co:#1}}}
\newcommand{\axref} [1]{\textsf{\bfseries Axiom~\ref{ax:#1}}}
\newcommand{\deref} [1]{\textsf{\bfseries Definition~\ref{de:#1}}}
\newcommand{\lemref}[1]{\textsf{\bfseries Lemma~\ref{le:#1}}}
\newcommand{\exref} [1]{\textsf{\bfseries Example~\ref{ex:#1}}}
\newcommand{\quref} [1]{\textsf{\bfseries Question~\ref{qu:#1}}}
% 後方互換：旧来コードで \leqqref を使っていた場合
\providecommand{\leqqref}[1]{\lemref{#1}}

